#!/bin/sh

set -f

PROG="${0##*/}"

vmm_dir="$HOME/vmm"
images_dir="${XDG_DATA_HOME:-$HOME/.local/share}/vmm/images"
iso_dir="${XDG_DATA_HOME:-$HOME/.local/share}/vmm/iso"

default_boot_drive_url='https://ftp.altlinux.org/pub/distributions/ALTLinux/images/Sisyphus/cloud/x86_64/alt-sisyphus-cloud-x86_64.qcow2'
default_disk_size='10G'

show_help()
{
	cat <<-EOF
	shvmm-run [options] VM_NAME

	Options:
	  --replace			first delete VM with this name if it already exists
	  --iso-path <path>		attach the ISO at this path to the VM as cdrom
	  --iso-url <URL>		attach the ISO at this url to the VM as cdrom
	  --create-boot-drive		create empty qcow2 file as boot drive for the VM
	  --disk-size <GB>		allocate this much disk space for the boot drive (default: $default_disk_size)
	  --boot-drive-url <URL>	use qcow2 file at this url as boot image (default: $default_boot_drive_url)
	  --second-drive <path>		path to qcow2 file to attach another drive to the VM
	  --net-tap <tap>		use QEMU tap networking and connect VM's NIC to tap device with this name
	  --net-address-cidr <IP-CIDR>	assign this IP address and network mask to the VM's network interface
	  --net-gateway <IP>		use this IP as the default gateway in the VM
	  --net-dhcp			enable dhcp discovery in VM
	  --spice			enable and connect to SPICE
	  --no-cloud-init-drive		don't attach cloud-init drive for NoCloud datasource
	  --log-serial			redirect serial port to a file
	  -v, --verbose			print executed commands
	  -h, --help			show help and exit
	EOF
}

fatal()
{
	printf '%s: %s\n' "$PROG" "$1" >&2
	exit 1
}

vm_name=
verbose=0
replace=0
iso_path_option=
iso_url=
create_boot_drive=0
disk_size=
boot_drive_url=
second_drive=
network_tap_device_name=
network_vm_ip_address_cidr=
network_vm_default_gateway=
network_vm_dhcp=0
enable_spice=0
attach_cloud_init_drive=1
log_serial=0
while true; do
	case "$1" in
	-h | --help)
		show_help
		exit 0
		;;
	-v | --verbose)
		verbose=1
		shift
		;;
	--replace)
		replace=1
		shift
		;;
	--iso-path)
		iso_path_option="$2"
		shift 2
		;;
	--iso-url)
		iso_url="$2"
		shift 2
		;;
	--create-boot-drive)
		create_boot_drive=1
		shift
		;;
	--disk-size)
		disk_size="$2"
		shift 2
		;;
	--boot-drive-url)
		boot_drive_url="$2"
		shift 2
		;;
	--second-drive)
		second_drive="$2"
		shift 2
		;;
	--net-tap)
		network_tap_device_name="$2"
		shift 2
		;;
	--net-address-cidr)
		network_vm_ip_address_cidr="$2"
		shift 2
		;;
	--net-gateway)
		network_vm_default_gateway="$2"
		shift 2
		;;
	--net-dhcp)
		network_vm_dhcp=1
		shift 1
		;;
	--spice)
		enable_spice=1
		shift
		;;
	--no-cloud-init-drive)
		attach_cloud_init_drive=0
		shift
		;;
	--log-serial)
		log_serial=1
		shift
		;;
	-*)
		printf >&2 "ERROR: Invalid flag '%s'\n\n" "$1"
		show_help
		exit 1
		;;
	*)
		if [ -n "$1" ]; then
			vm_name="$1"
			shift
		else
			break
		fi
		;;
	esac
done

[ "$verbose" -eq 0 ] || set -x

[ -n "$vm_name" ] || fatal 'VM_NAME is not specified'
[ -n "$boot_drive_url" ] || boot_drive_url="$default_boot_drive_url"
[ -n "$disk_size" ] || disk_size="$default_disk_size"

vm_dir="$vmm_dir/$vm_name"
vm_config_path="$vm_dir/vmm.conf"
monitor_socket_path="$vm_dir/monitor.socket"

if [ -d "$vm_dir" ]; then
	[ "$replace" -eq 1 ] || fatal "VM '$vm_name' already exists"

	if [ -S "$monitor_socket_path" ]; then
		printf "quit\n" | socat - "unix:$monitor_socket_path" > /dev/null
	fi

	rm -rf "$vm_dir"
fi

vm_mac_address="52:54:00:$(printf '%s' "$vm_name" | crc32 /dev/stdin | tail -c7 | sed -E 's/([a-f0-9]{2})/\1:/g' | head -c8)"

mkdir -p "$vm_dir"

vm_disk_path="$vm_dir/disk.qcow2"
vm_cloud_init_drive_path="$vm_dir/cloud_init_drive.img"

mkdir -p "$images_dir"
mkdir -p "$iso_dir"

boot_drive_path="$images_dir/${boot_drive_url##*/}"
[ -n "$iso_path" ] || iso_path="$iso_dir/${iso_url##*/}"

if [ "$create_boot_drive" -eq 0 ] && [ ! -f "$boot_drive_path" ]; then
	echo "Downloading boot drive image from '$boot_drive_url'" >&2
	curl "$boot_drive_url" --output "$boot_drive_path" --fail --location || fatal "Failed to download the boot drive image '$boot_drive_url'"
elif [ "$create_boot_drive" -eq 1 ] && [ -n "$iso_url" ] && [ ! -f "$iso_path" ]; then
	echo "Downloading ISO from '$iso_url'" >&2
	curl "$iso_url" --output "$iso_path" --fail --location || fatal "Failed to download the ISO '$boot_drive_url'"
fi

if [ "$create_boot_drive" -eq 0 ]; then
	qemu-img create -b "$boot_drive_path" -F qcow2 -f qcow2 "$vm_disk_path" "$disk_size" > /dev/null || fatal "Failed to create a boot drive for '$vm_name' from '$boot_drive_url'"
else
	qemu-img create -f qcow2 "$vm_disk_path" "$disk_size" > /dev/null || fatal "Failed to create a new empty boot drive for '$vm_name'"
fi

ssh_key_path="$vm_dir/id_ed25519"

ssh-keygen -t ed25519 -f "$ssh_key_path" -N '' > /dev/null

pub_ssh_key_path="${ssh_key_path}.pub"
pub_ssh_key="$(cat "$pub_ssh_key_path")"

user_data_path="$vm_dir/user-data.yaml"

cat <<EOF > "$user_data_path"
#cloud-config
disable_root: false
users:
  - name: root
    lock_passwd: false
    plain_text_passwd: "123"
    ssh_authorized_keys:
      - ${pub_ssh_key}
preserve_hostname: false
hostname: ${vm_name}
EOF

network_type='user'
[ -n "$network_tap_device_name" ] && network_type='tap'

echo "network_type=$network_type" >> "$vm_config_path"

if [ "$network_type" = 'user' ]; then
	cloud-localds "$vm_cloud_init_drive_path" "$user_data_path"
else
	network_config_path="$vm_dir/network.yaml"

	if [ "$network_vm_dhcp" -eq 1 ]; then
		cat <<-EOF > "$network_config_path"
		version: 2
		ethernets:
		  interface0:
		    match:
		      name: "e*"
		    dhcp4: true
		EOF
	else
		cat <<-EOF > "$network_config_path"
		version: 2
		ethernets:
		  interface0:
		    match:
		      name: "e*"
		    addresses:
		      - $network_vm_ip_address_cidr
		    routes:
		      - to: 0.0.0.0/0
		        via: $network_vm_default_gateway
		    nameservers:
		      addresses:
		        - 8.8.8.8
		EOF
	fi

	cloud-localds --network-config "$network_config_path" "$vm_cloud_init_drive_path" "$user_data_path"
fi

vm_uuid="$(uuidgen)"
echo "vm_uuid=$vm_uuid" >> "$vm_config_path"

set -- -name "$vm_name" \
	-accel kvm \
	-cpu host \
	-m 2G \
	-smp 2 \
	-daemonize \
	-smbios "type=1,uuid=$vm_uuid" \
	-monitor "unix:${monitor_socket_path},server=on,wait=off" \
	-blockdev "node-name=disk1,discard=unmap,driver=qcow2,file.driver=file,file.filename=${vm_disk_path}" \
	-device virtio-blk-pci,drive=disk1

if [ "$attach_cloud_init_drive" -eq 1 ]; then
	set -- "$@" -blockdev "node-name=cloud-init-drive,read-only=on,force-share=on,driver=raw,file.driver=file,file.filename=${vm_cloud_init_drive_path}" \
		-device virtio-blk-pci,drive=cloud-init-drive
fi

echo "attach_cloud_init_drive=$attach_cloud_init_drive" >> "$vm_config_path"

if [ -n "$second_drive" ]; then
	echo "second_drive=$second_drive" >> "$vm_config_path"

	set -- "$@" -blockdev "node-name=disk2,discard=unmap,driver=qcow2,file.driver=file,file.filename=${second_drive}" \
		-device virtio-blk-pci,drive=disk2
fi

if [ -n "$iso_path_option" ] || [ -n "$iso_url" ]; then
	set -- "$@" -blockdev "node-name=cdrom1,read-only=on,force-share=on,driver=raw,file.driver=file,file.filename=$iso_path" \
		-device ide-cd,drive=cdrom1
fi

if [ "$network_type" = 'user' ]; then
	port=24000
	while [ "$(ss --no-header --tcp state all sport "$port" | wc -l)" -ne 0 ]; do
		port=$((port + 1))
	done

	echo "ssh_port=$port" >> "$vm_config_path"

	set -- "$@" -netdev "user,id=net0,hostfwd=tcp:127.0.0.1:${port}-:22" \
		-device "virtio-net-pci,netdev=net0,mac=${vm_mac_address}"
fi

if [ "$network_type" = 'tap' ]; then
	echo "network_tap_device_name=$network_tap_device_name" >> "$vm_config_path"

	set -- "$@" -netdev "tap,id=net0,ifname=${network_tap_device_name},script=no" \
		-device "virtio-net-pci,netdev=net0,mac=${vm_mac_address}"
fi

echo "vm_mac_address=$vm_mac_address" >> "$vm_config_path"

if [ "$enable_spice" -eq 1 ]; then
	echo "enable_spice=$enable_spice" >> "$vm_config_path"

	set -- "$@" -display spice-app
fi

echo "log_serial=$log_serial" >> "$vm_config_path"

if [ "$log_serial" -eq 1 ]; then
	qemu_serial_log_path="$vm_dir/serial.log"
	set -- "$@" -serial "file:$qemu_serial_log_path"
fi

qemu-system-x86_64 "$@"

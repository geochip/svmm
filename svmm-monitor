#!/usr/bin/env sh

set -f

# shellcheck disable=SC2034 # PROG is used by svmm-common
PROG="${0##*/}"

. svmm-common

show_help()
{
	cat <<-EOF
	svmm-monitor [options] COMMAND VM_NAME

	Commands:
	  raw				connect to monitor socket to issue raw QMP requests
	  hmp				connect to the VM's HMP monitor (classic commands like 'info block')
	  query-block			query info about block devices
	  eject <DEVICE_ID>		eject device with id DEVICE_ID
	  change <DEVICE_ID> <FILENAME>	change device with id DEVICE_ID to FILENAME

	Options:
	  -v, --verbose			print executed commands
	  -h, --help			show help and exit
	EOF
}

verbose=0
command=
vm_name=
device_id=
filename=
while true; do
	case "$1" in
	-v | --verbose)
		verbose=1
		shift
		;;
	-h | --help)
		show_help
		exit 0
		;;
	-*)
		printf >&2 "ERROR: Invalid flag '%s'\n\n" "$1"
		show_help
		exit 1
		;;
	raw)
		command=raw
		shift
		;;
	hmp)
		command=hmp
		shift
		;;
	query-block)
		command=query-block
		shift
		;;
	eject)
		command=eject
		shift
		if [ -n "$1" ]; then
			device_id="$1"
			shift
		else
			fatal 'device id to eject is not specified'
		fi
		;;
	change)
		command=change
		shift
		if [ -n "$1" ] && [ -n "$2" ]; then
			device_id="$1"
			filename="$2"
			shift 2
		else
			fatal 'device id to change or filename are not specified'
		fi
		;;
	*)
		if [ -n "$1" ]; then
			vm_name="$1"
			shift
		else
			break
		fi
		;;
	esac
done

[ "$verbose" -eq 0 ] || set -x

[ -n "$command" ] || fatal 'COMMAND is not specified'
[ -n "$vm_name" ] || fatal 'VM_NAME is not specified'

vm_dir="$vmm_dir/$vm_name"
monitor_socket_path="$vm_dir/monitor.socket"
hmp_socket_path="$vm_dir/hmp.socket"

[ -d "$vm_dir" ] || fatal "VM '$vm_name' doesn't exist"

if [ "$command" = 'hmp' ]; then
	[ -S "$hmp_socket_path" ] || fatal "hmp monitor socket is not accessible for VM '$vm_name'"
else
	[ -S "$monitor_socket_path" ] || fatal "monitor socket is not accessible for VM '$vm_name'"
fi

if [ "$command" = 'raw' ]; then
	if [ -t 0 ]; then
		# interactive: readline provides line editing and history
		socat READLINE "UNIX-CONNECT:$monitor_socket_path"
	else
		# piped or redirected stdin: plain stdio so scripts can feed
		# QMP commands, e.g. printf ... | svmm monitor raw VM
		socat - "UNIX-CONNECT:$monitor_socket_path"
	fi
	exit
fi

if [ "$command" = 'hmp' ]; then
	if [ -t 0 ]; then
		# interactive: connect with a raw terminal so QEMU's readline
		# handles editing, history and tab completion (cooked mode
		# would echo input twice)
		socat -,raw "UNIX-CONNECT:$hmp_socket_path"
	else
		# piped or redirected stdin: plain stdio so the reply isn't cut
		# off on EOF; QEMU's line editor still re-echoes the input, use
		# the QMP socket for clean scripting
		socat - "UNIX-CONNECT:$hmp_socket_path"
	fi
	exit
fi

if [ "$command" = 'query-block' ]; then
	qmp "$monitor_socket_path" '{"execute":"query-block"}' | jq -r '.return[]? | "\(.qdev) \(.inserted.image.filename)"'
	exit
fi

if [ "$command" = 'eject' ]; then
	qmp "$monitor_socket_path" '{"execute":"eject","arguments":{"id":"'"$device_id"'"}}' > /dev/null
	exit
fi

if [ "$command" = 'change' ]; then
	qmp "$monitor_socket_path" '{"execute":"blockdev-change-medium","arguments":{"id":"'"$device_id"'","filename":"'"$filename"'","format":"raw"}}' > /dev/null
	exit
fi
